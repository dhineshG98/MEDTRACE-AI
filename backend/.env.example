# ==========================================
# MedTrace AI — Backend Configuration (.env)
# ==========================================

# Application Settings
ENVIRONMENT=development
API_PREFIX=/api
UPLOAD_DIR=uploads
DATABASE_URL=sqlite:///./medtrace.db
MAX_UPLOAD_SIZE_MB=25

# ==========================================
# Online Cloud AI Configuration
# ==========================================
# Select AI provider: "auto", "gemini", "openai", "anthropic", or "heuristic"
AI_PROVIDER=auto

# 1. Google Gemini (Recommended for fast clinical extraction)
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# 2. OpenAI (GPT-4o)
# OPENAI_API_KEY=sk-proj-your_openai_key_here
# AI_MODEL=gpt-4o-mini

# 3. Anthropic (Claude 3.5 Sonnet)
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
# AI_MODEL=claude-3-5-sonnet-20241022

# ==========================================
# Optical Character Recognition (OCR)
# ==========================================
# Optional: Set path to tesseract.exe if not on system PATH
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGES=eng
